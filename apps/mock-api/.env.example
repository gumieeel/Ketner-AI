# Порт mock-API. Должен совпадать с proxy в apps/web/vite.config.ts.
PORT=8787

# Окружение: development | production
NODE_ENV=development

# Origin, которому разрешены запросы (dev-сервер Vite).
CORS_ORIGIN=http://localhost:5173

# Адрес интерфейса: его подсказывает ответ GET / (порт API открывают по ошибке).
WEB_APP_URL=http://localhost:5173

# Файл с диалогами и сообщениями. По умолчанию apps/mock-api/data/store.json.
STORE_FILE=

# Заглушка ИИ: пауза перед первым чанком (экран показывает «думает…»), мс.
MOCK_AI_THINKING_MIN_MS=350
MOCK_AI_THINKING_MAX_MS=900

# Заглушка ИИ: пауза между чанками — имитация стриминга токенов, мс.
MOCK_AI_CHUNK_MIN_MS=20
MOCK_AI_CHUNK_MAX_MS=40

# Доля запросов, на которые заглушка отвечает ошибкой: 0 — никогда, 1 — всегда.
MOCK_AI_FAILURE_RATE=0
