# ============================================================
# Ketner AI — Mock API: переменные окружения
# ============================================================
# Скопируй этот файл в .env и заполни нужные значения.
# Файл .env не коммитится (см. .gitignore).
# ============================================================

# ── Сервер ───────────────────────────────────────────────────
PORT=8787
NODE_ENV=development

# CORS: разрешённый origin фронтенда
CORS_ORIGIN=http://localhost:5173

# URL фронтенда (отображается в ответах API)
WEB_APP_URL=http://localhost:5173

# ── Секреты (в production ОБЯЗАТЕЛЬНЫ, ≥ 32 символов) ────────
# Без них при NODE_ENV=production приложение не запустится.
# В репозитории нет ни одного рабочего ключа: все значения берутся только отсюда.
#
# Better Auth. Сгенерируй: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Ключ подписи Bearer-токенов. Необязателен: если пусто, выводится из BETTER_AUTH_SECRET.
# Сгенерируй отдельный: openssl rand -hex 32
AUTH_JWT_SECRET=
BETTER_AUTH_URL=http://localhost:8787

# Better Auth Infrastructure / Dashboard API Key (из app.better-auth.com)
BETTER_AUTH_API_KEY=

# ── Supabase & PostgreSQL ────────────────────────────────────
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# По умолчанию выводится из SUPABASE_URL
SUPABASE_JWKS_URL=

# ── OAuth: Google ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth: GitHub ────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Telegram Bot ─────────────────────────────────────────────
# Токены выдаёт @BotFather. Пусто = бот выключен.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUPPORT_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_PAYMENT_PROVIDER_TOKEN=
TELEGRAM_WEBHOOK_URL=

# ── CryptoCloud (Приём криптовалюты) ─────────────────────────
# Получить в ЛК CryptoCloud: https://cryptocloud.plus
CRYPTOCLOUD_API_KEY=
CRYPTOCLOUD_SHOP_ID=
CRYPTOCLOUD_SECRET_KEY=

# ── ИИ: один ключ OpenRouter на все модели ──────────────────
# Через него идут GPT, Claude, Grok, Gemini, DeepSeek и MiMo; отдельные ключи OpenAI,
# Anthropic и Google не нужны. Ключ: https://openrouter.ai/keys
# Следите за балансом: при нуле на счёте перестают работать все платные модели сразу.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Webhook & Admin API (обязательно в production, ≥ 32 символов) ──
# Сгенерируй: openssl rand -hex 32
WEBHOOK_SECRET=
ADMIN_API_KEY=
# Временное исключение: разрешить ранее опубликованный секрет (небезопасно, только осознанно)
# ALLOW_COMPROMISED_SECRETS=true

# ── VIP / Admin доступ ───────────────────────────────────────
# Списки email через запятую. В коде нет встроенных адресов и префиксов (admin@…).
# В production такие адреса нельзя занять самостоятельной регистрацией по паролю.
VIP_EMAILS=
ADMIN_EMAILS=

# Первичный администратор: создаётся/обновляется при старте, если оба поля заданы.
# Пароль ≥ 12 символов; после первого входа смени его в интерфейсе и очисти переменную.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Ручное подтверждение крипто-переводов по TxID (только USDT TRC-20). В production выключено,
# пока не задано true. Без CryptoCloud и без этого флага оплата криптой недоступна.
# ENABLE_MANUAL_CRYPTO=true

# Демо-аккаунт demo@ketner.ai и POST /api/auth/demo: по умолчанию включены только вне production.
# ENABLE_DEMO_ACCOUNT=true  # включать в production только осознанно

# ── Файловые хранилища (опционально — по умолчанию apps/mock-api/data/) ──
STORE_FILE=
USER_STORE_FILE=
SUBSCRIPTION_STORE_FILE=
USAGE_STORE_FILE=
AUTH_DB_FILE=

# ── Курс валюты ──────────────────────────────────────────────
USD_TO_RUB_RATE=95

# ── Mock AI настройки ────────────────────────────────────────
MOCK_AI_THINKING_MIN_MS=350
MOCK_AI_THINKING_MAX_MS=900
MOCK_AI_CHUNK_MIN_MS=20
MOCK_AI_CHUNK_MAX_MS=40
MOCK_AI_FAILURE_RATE=0
