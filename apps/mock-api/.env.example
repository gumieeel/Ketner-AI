# ============================================================
# Ketner AI — Mock API: переменные окружения
# ============================================================
# Скопируй этот файл в .env и заполни нужные значения.
# Файл .env не коммитится (см. .gitignore).
# ============================================================

# ── Сервер ───────────────────────────────────────────────────
PORT=8787
NODE_ENV=development

# CORS: разрешённый origin фронтенда
CORS_ORIGIN=http://localhost:5173

# URL фронтенда (отображается в ответах API)
WEB_APP_URL=http://localhost:5173

# ── Секреты (в production ОБЯЗАТЕЛЬНЫ, ≥ 32 символов) ────────
# Без них при NODE_ENV=production приложение не запустится.
# В репозитории нет ни одного рабочего ключа: все значения берутся только отсюда.
#
# Better Auth. Сгенерируй: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Ключ подписи Bearer-токенов. Необязателен: если пусто, выводится из BETTER_AUTH_SECRET.
# Сгенерируй отдельный: openssl rand -hex 32
AUTH_JWT_SECRET=
BETTER_AUTH_URL=http://localhost:8787

# Better Auth Infrastructure / Dashboard API Key (из app.better-auth.com)
BETTER_AUTH_API_KEY=

# ── Supabase & PostgreSQL ────────────────────────────────────
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── OAuth: Google ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth: GitHub ────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Telegram Bot ─────────────────────────────────────────────
# Токены выдаёт @BotFather. Пусто = бот выключен.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUPPORT_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_PAYMENT_PROVIDER_TOKEN=
# Курс цены в звёздах, $ за звезду. По умолчанию — официальная цена Telegram (1 000 ⭐ = $19.99);
# задавайте, только если Telegram изменит прайс. Ниже точки безубыточности цена всё равно не опустится.
# STARS_USD_RATE=0.01999
TELEGRAM_WEBHOOK_URL=
# Оператор бота поддержки. Рекомендуется закрепить chat id (число): тогда права даёт только этот
# чат, а не username, который можно сменить и который займёт другой человек.
SUPPORT_ADMIN_USERNAME=
SUPPORT_ADMIN_CHAT_ID=

# ── Почта (SMTP): коды привязки Telegram ──────────────────────
# Любой SMTP-сервис. 465 — TLS сразу, 587 — STARTTLS. Без SMTP вне production письмо идёт в лог.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Ketner AI <no-reply@ketner.org>

# ── CryptoCloud (Приём криптовалюты) ─────────────────────────
# Получить в ЛК CryptoCloud: https://cryptocloud.plus
CRYPTOCLOUD_API_KEY=
CRYPTOCLOUD_SHOP_ID=
CRYPTOCLOUD_SECRET_KEY=

# ── ИИ: один ключ OpenRouter на все модели ──────────────────
# Через него идут GPT, Claude, Grok, Gemini, DeepSeek и MiMo. Ключ: https://openrouter.ai/keys
# Следите за балансом: при нуле на счёте перестают работать все платные модели сразу.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── ИИ: прямые API вендоров (необязательно, по умолчанию выключены) ──
# Если ключ задан, модели этого вендора идут напрямую (без наценки OpenRouter на пополнение),
# а при ошибке прямого API запрос повторяется через OpenRouter; после серии ошибок
# предохранитель на 30 секунд отправляет модель только через OpenRouter.
# Цены прямых API — в реестре моделей (src/ai/model-registry.ts, поле direct).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Свои адреса нужны только для прокси/шлюза перед API вендора.
OPENAI_BASE_URL=https://api.openai.com/v1
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ── Картинки: Cloudflare Workers AI (FLUX) ──────────────────
# 10 000 бесплатных «нейронов» в сутки (~170 картинок FLUX.1 schnell), дальше $0.011 за 1000.
# Account ID: панель Cloudflare → Workers AI. Токен: My Profile → API Tokens, право «Workers AI: Read».
# Без этих двух переменных страница «Изображения» показывает, что генерация недоступна.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Runware: платные модели для Pro и Ultra (FLUX.2 dev/pro, Seedream, Nano Banana). Ключ: my.runware.ai.
# Нужен положительный баланс (для моделей сторонних провайдеров — пополнение от $5). Без ключа или
# при пустом балансе отвечают модели Cloudflare.
RUNWARE_API_KEY=

# ── Webhook & Admin API (обязательно в production, ≥ 32 символов) ──
# Сгенерируй: openssl rand -hex 32
WEBHOOK_SECRET=
ADMIN_API_KEY=
# Временное исключение: разрешить ранее опубликованный секрет (небезопасно, только осознанно)
# ALLOW_COMPROMISED_SECRETS=true

# ── VIP / Admin доступ ───────────────────────────────────────
# Списки email через запятую. В коде нет встроенных адресов и префиксов (admin@…).
# В production такие адреса нельзя занять самостоятельной регистрацией по паролю.
VIP_EMAILS=
ADMIN_EMAILS=

# Первичный администратор: создаётся/обновляется при старте, если оба поля заданы.
# Пароль ≥ 12 символов; после первого входа смени его в интерфейсе и очисти переменную.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Демо-аккаунт demo@ketner.ai и POST /api/auth/demo: по умолчанию включены только вне production.
# ENABLE_DEMO_ACCOUNT=true  # включать в production только осознанно

# ── Файловые хранилища (опционально — по умолчанию apps/mock-api/data/) ──
STORE_FILE=
USER_STORE_FILE=
SUBSCRIPTION_STORE_FILE=
USAGE_STORE_FILE=
AUTH_DB_FILE=

# ── Курс валюты ──────────────────────────────────────────────
USD_TO_RUB_RATE=95

# ── Mock AI настройки ────────────────────────────────────────
MOCK_AI_THINKING_MIN_MS=350
MOCK_AI_THINKING_MAX_MS=900
MOCK_AI_CHUNK_MIN_MS=20
MOCK_AI_CHUNK_MAX_MS=40
MOCK_AI_FAILURE_RATE=0

# ── Ketner Code (проекты и агент) ────────────────────────────
# CODE_PROJECTS_DIR=            # по умолчанию apps/mock-api/data/projects
# Запуск команд агентом: off | docker | local (local — только для разработки)
SANDBOX_MODE=off
# SANDBOX_DOCKER_IMAGE=node:22-bookworm-slim
# SANDBOX_ALLOW_NETWORK=false
# SANDBOX_ALLOW_LOCAL_IN_PRODUCTION=false
