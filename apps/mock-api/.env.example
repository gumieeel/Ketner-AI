# ============================================================
# Ketner AI — Mock API: переменные окружения
# ============================================================
# Скопируй этот файл в .env и заполни нужные значения.
# Файл .env не коммитится (см. .gitignore).
# ============================================================

# ── Сервер ───────────────────────────────────────────────────
PORT=8787
NODE_ENV=development

# CORS: разрешённый origin фронтенда
CORS_ORIGIN=http://localhost:5173

# URL фронтенда (отображается в ответах API)
WEB_APP_URL=http://localhost:5173

# ── Better Auth (обязательно) ────────────────────────────────
# Сгенерируй: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787

# Better Auth Infrastructure / Dashboard API Key (из app.better-auth.com)
BETTER_AUTH_API_KEY=

# ── Supabase & PostgreSQL ────────────────────────────────────
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://gwioimhpfulpjxzsuesy.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://gwioimhpfulpjxzsuesy.supabase.co/auth/v1/.well-known/jwks.json

# ── OAuth: Google ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth: GitHub ────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Telegram Bot ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_PAYMENT_PROVIDER_TOKEN=
TELEGRAM_WEBHOOK_URL=

# ── CryptoCloud (Приём криптовалюты) ─────────────────────────
# Получить в ЛК CryptoCloud: https://cryptocloud.plus
CRYPTOCLOUD_API_KEY=
CRYPTOCLOUD_SHOP_ID=
CRYPTOCLOUD_SECRET_KEY=

# ── AI Providers ─────────────────────────────────────────────
# OpenRouter (агрегатор моделей)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Google Gemini
GEMINI_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ── Webhook & Admin API (обязательно в продакшне) ────────────
# Сгенерируй: openssl rand -hex 32
WEBHOOK_SECRET=
ADMIN_API_KEY=

# ── VIP / Admin доступ ───────────────────────────────────────
# Список email через запятую
VIP_EMAILS=
ADMIN_EMAILS=

# ── Файловые хранилища (опционально — по умолчанию apps/mock-api/data/) ──
STORE_FILE=
USER_STORE_FILE=
SUBSCRIPTION_STORE_FILE=
USAGE_STORE_FILE=
AUTH_DB_FILE=

# ── Курс валюты ──────────────────────────────────────────────
USD_TO_RUB_RATE=95

# ── Mock AI настройки ────────────────────────────────────────
MOCK_AI_THINKING_MIN_MS=350
MOCK_AI_THINKING_MAX_MS=900
MOCK_AI_CHUNK_MIN_MS=20
MOCK_AI_CHUNK_MAX_MS=40
MOCK_AI_FAILURE_RATE=0
