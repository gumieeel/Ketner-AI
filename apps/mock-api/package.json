{
  "name": "@ketner/mock-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "bot": "tsx src/telegram/runner.ts",
    "typecheck": "tsc --noEmit",
    "test": "cross-env BETTER_AUTH_SECRET=test-secret-for-ci-at-least-32-chars-long tsx --test \"src/**/*.test.ts\"",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:data": "tsx src/scripts/migrate-data.ts",
    "migrate:generate": "drizzle-kit generate",
    "migrate:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:test": "tsx src/scripts/test-db.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@better-auth/infra": "^0.4.12",
    "@supabase/supabase-js": "^2.117.2",
    "better-auth": "^1.7.5",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "postgres": "^3.4.9",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "cross-env": "^7.0.3",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
