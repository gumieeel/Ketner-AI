+test('бюджет исчерпан (100–125%): явный выбор дорогой модели понижается до дешёвой', async () => {
+  const usage = newUsage();
+  const calls: Call[] = [];
+  const gateway = makeGateway(fakeOpenRouter(okStream('ок'), calls), usage);
