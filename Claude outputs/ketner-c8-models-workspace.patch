+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { resolveBillingPlan, SUBSCRIPTION_GRACE_MS } from './plan-resolver.js';
+
+const NOW = Date.parse('2026-10-06T12:00:00Z');
+const iso = (offsetMs: number): string => new Date(NOW + offsetMs).toISOString();
+
+test('free остаётся free независимо от подписки', () => {
+  const r = resolveBillingPlan({
+    storedPlan: 'free',
+    subscription: { plan: 'pro', status: 'active', renewsAt: iso(86_400_000) },
+    now: NOW,
+  });
+  assert.deepEqual(r, { plan: 'free', expired: false });
+});
+
+test('оплаченный и не истёкший тариф сохраняется', () => {
+  const r = resolveBillingPlan({
+    storedPlan: 'pro',
+    subscription: { plan: 'pro', status: 'active', renewsAt: iso(5 * 86_400_000) },
+    now: NOW,
+  });
+  assert.deepEqual(r, { plan: 'pro', expired: false });
+});
+
+test('тариф истёк и льготный период прошёл — сводится к free', () => {
+  const r = resolveBillingPlan({
+    storedPlan: 'ultra',
+    subscription: { plan: 'ultra', status: 'active', renewsAt: iso(-SUBSCRIPTION_GRACE_MS - 1000) },
+    now: NOW,
+  });
+  assert.deepEqual(r, { plan: 'free', expired: true });
+});
+
+test('внутри льготного периода тариф ещё действует', () => {
+  const r = resolveBillingPlan({
+    storedPlan: 'plus',
+    subscription: { plan: 'plus', status: 'active', renewsAt: iso(-1000) },
+    now: NOW,
+  });
+  assert.deepEqual(r, { plan: 'plus', expired: false });
+});
+
+test('отменённая подписка действует до конца периода, потом free', () => {
+  const live = resolveBillingPlan({
+    storedPlan: 'pro',
+    subscription: { plan: 'pro', status: 'canceled', renewsAt: iso(86_400_000) },
+    now: NOW,
+  });
+  assert.equal(live.plan, 'pro');
+  const dead = resolveBillingPlan({
+    storedPlan: 'pro',
+    subscription: { plan: 'pro', status: 'canceled', renewsAt: iso(-1000) },
+    now: NOW,
+  });
+  assert.deepEqual(dead, { plan: 'free', expired: true });
+  const noDate = resolveBillingPlan({
+    storedPlan: 'pro',
+    subscription: { plan: 'pro', status: 'canceled', renewsAt: null },
+    now: NOW,
+  });
+  assert.equal(noDate.plan, 'free');
+});
+
+test('нет записи подписки — платный тариф из профиля не отнимается', () => {
+  assert.equal(resolveBillingPlan({ storedPlan: 'pro', subscription: null, now: NOW }).plan, 'pro');
+  assert.equal(
+    resolveBillingPlan({
+      storedPlan: 'pro',
+      subscription: { plan: 'free', status: 'active', renewsAt: null },
+      now: NOW,
+    }).plan,
+    'pro',
+  );
+});
+
+test('VIP всегда ultra', () => {
+  const r = resolveBillingPlan({
+    storedPlan: 'free',
+    isVip: true,
+    subscription: { plan: 'pro', status: 'canceled', renewsAt: iso(-86_400_000 * 40) },
+    now: NOW,
+  });
+  assert.deepEqual(r, { plan: 'ultra', expired: false });
+});
diff --git a/apps/mock-api/src/services/plan-resolver.ts b/apps/mock-api/src/services/plan-resolver.ts
new file mode 100644
index 0000000..edd5612
--- /dev/null
+++ b/apps/mock-api/src/services/plan-resolver.ts
@@ -0,0 +1,62 @@
+/**
+ * Эффективный тариф пользователя с учётом срока подписки.
+ *
+ * Оплата криптой и Telegram Stars разовая: `renewsAt` ставится на 30 дней вперёд и дальше
+ * никто не продлевает подписку сам. Без этой проверки одна оплата давала тариф навсегда.
+ * Функция чистая — без обращений к хранилищам, поэтому проверяется юнит-тестами без сервера.
+ */
+
+import type { PlanId, Subscription } from '../types.js';
+
+/** Запас после окончания периода: задержка вебхука продления не должна обрывать работу. */
+export const SUBSCRIPTION_GRACE_MS = 24 * 60 * 60 * 1000;
+
+export interface PlanResolutionInput {
+  /** Тариф, записанный в профиле пользователя (или в сессии). */
+  storedPlan: PlanId | undefined;
+  /** Запись подписки; отсутствие записи не лишает платного тарифа (устаревшие данные). */
+  subscription?: Pick<Subscription, 'plan' | 'status' | 'renewsAt'> | null;
+  /** VIP всегда получает Ultra, подписка ему не нужна. */
+  isVip?: boolean;
+  now?: number;
+}
+
+export interface PlanResolution {
+  plan: PlanId;
+  /** true, если платный тариф закончился и сведён к free. */
+  expired: boolean;
+}
+
+export function resolveBillingPlan(input: PlanResolutionInput): PlanResolution {
+  if (input.isVip) {
+    return { plan: 'ultra', expired: false };
+  }
+
+  const stored: PlanId = input.storedPlan ?? 'free';
+  if (stored === 'free') {
+    return { plan: 'free', expired: false };
+  }
+
+  const sub = input.subscription;
+  if (!sub || sub.plan === 'free') {
+    // Записи о платеже нет (старые данные или ручная правка профиля) — тариф не трогаем.
+    return { plan: stored, expired: false };
+  }
+
+  const now = input.now ?? Date.now();
+  const endsAt = sub.renewsAt ? Date.parse(sub.renewsAt) : Number.NaN;
+
+  if (sub.status === 'canceled') {
+    // Отменённая подписка действует до конца оплаченного периода и не дольше.
+    if (Number.isNaN(endsAt) || now > endsAt) {
+      return { plan: 'free', expired: true };
+    }
+    return { plan: stored, expired: false };
+  }
+
+  if (!Number.isNaN(endsAt) && now > endsAt + SUBSCRIPTION_GRACE_MS) {
+    return { plan: 'free', expired: true };
+  }
+
+  return { plan: stored, expired: false };
+}
